# ══════════════════════════════════════════════════════════════════
#  AnomaFlow v2.0 — .gitignore
# ══════════════════════════════════════════════════════════════════

# ── Secrets & Config ──────────────────────────────────────────────
.env
*.env
!.env.example

# ── Base de données ───────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*_backup_*.db

# ── Uploads & Données ────────────────────────────────────────────
uploads/
data/

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Environnements virtuels ───────────────────────────────────────
venv/
.venv/
env/
ENV/
.env/
.venv/
virtualenv/

# ── Tests & Coverage ─────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml
*.cover

# ── IDEs ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────
# (on commit les fichiers de config mais pas les volumes)
docker-volumes/

# ── Caddy ─────────────────────────────────────────────────────────
caddy_data/
caddy_config/

# ── Logs ──────────────────────────────────────────────────────────
*.log
logs/

# ── Misc ──────────────────────────────────────────────────────────
*.bak
*.tmp
.mypy_cache/
.ruff_cache/.env
*.db
